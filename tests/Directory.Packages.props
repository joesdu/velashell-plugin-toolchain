<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 测试框架 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- 测试辅助 -->
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- S3 插件的测试要直接构造 AWSSDK 的请求/响应类型(替身客户端与环回服务器都要),
         版本与 plugins/VelaShell.Plugin.S3 保持一致。 -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.3" />
    <!-- Avalonia 一律取根 Directory.Build.props 的 VelaAvaloniaVersion —— 那是本仓库
         对插件生态锁定的版本(SDK 包用精确区间锁死的就是它)。测试宿主在这里扮演"装载方",
         版本必须与插件编译期看到的一致,否则 headless 会话里控件类型对不上。 -->
    <PackageVersion Include="Avalonia" Version="$(VelaAvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(VelaAvaloniaVersion)" />
    <!-- 菜单等控件的模板由主题提供:没有它 MenuItem 无模板、不可命中,真实点击测不了。 -->
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(VelaAvaloniaVersion)" />
    <!-- AI 面板的输入框:测试宿主要扮演"装载方"提供这份程序集。 -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="$(VelaAvaloniaEditVersion)" />
  </ItemGroup>
</Project>
