<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

	<!-- 插件在应用目录下的文件夹名:插件 id 把点换成短横(velashell.ai → velashell-ai)。
	     为什么不直接用 id:macOS 的 codesign 会把 .app 内**带点号的目录**当成嵌套 bundle 去解析,
	     `plugins/velashell.ai` 的 ".ai" 正好长得像扩展名,签名直接失败
	     ("bundle format unrecognized, invalid, or unsuitable",1.2.0 发版时踩到)。
	     为什么不干脆把 id 也改成短横:id 同时是插件数据与机密的命名空间
	     (plugin-data/<id>、SonnetDB 的 plugin_data 键前缀),改 id 等于让已有用户的
	     插件配置(AI 插件的 API key 就在里面)全部失联;而目录名不参与任何逻辑 ——
	     宿主发现插件是枚举子目录后从 plugin.json 读 id(PluginManager.Describe)。
	     三平台统一改,免得 tar.gz 与 .app 的 Contents/MacOS 布局分叉(那会让自更新解出
	     两份同 id 插件而互相判重)。注:用户经 .vpx 装到数据目录的插件仍按 id 建目录 ——
	     那些不在 .app 里,不参与签名。
	     本属性在 targets 而非 props 里算:props 先于项目正文导入,那时 VelaPluginId 还没赋值。 -->
	<PropertyGroup Condition="'$(VelaPluginId)' != ''">
		<VelaPluginDirName>$(VelaPluginId.Replace(".", "-"))</VelaPluginDirName>
	</PropertyGroup>

	<!-- 开发内环:构建后把插件输出镜像到**本机 VelaShell 的插件目录**下,F5(或直接启动)
	     即可加载到最新插件,无需手工拷贝。

	     拆库之前这里写死的是同仓库的 src/VelaShell/bin/<配置>/net11.0/plugins ——
	     本仓库没有宿主工程了,改成两段:
	       · 总是镜像一份到 artifacts/plugins/<目录名>/(打包用的暂存布局,也方便手工拷);
	       · 若指定了 VelaDevAppDir(属性,或环境变量 VELASHELL_DEV_APP_DIR),再镜像一份到
	         该应用目录的 plugins/<目录名>/ —— 指向宿主仓库的
	         src/VelaShell/bin/Debug/net11.0 即恢复原来的开发内环。
	     两处都不参与发布判定;哪个插件进发行包只看 VelaPluginShip(见 GetVelaPluginPayload)。
	     示例插件在开发目录里照样铺开:本机就是要能跑起来看效果。 -->
	<PropertyGroup>
		<VelaDevAppDir Condition="'$(VelaDevAppDir)' == ''">$(VELASHELL_DEV_APP_DIR)</VelaDevAppDir>
	</PropertyGroup>

	<Target Name="CopyVelaPluginToAppOutput" AfterTargets="Build" Condition="'$(VelaPluginId)' != ''">
		<ItemGroup>
			<_VelaPluginFiles Include="$(TargetDir)**\*" />
		</ItemGroup>

		<!-- 暂存布局 -->
		<RemoveDir Directories="$(VelaArtifactsDir)\plugins\$(VelaPluginId)"
		           Condition="'$(VelaPluginDirName)' != '$(VelaPluginId)'" />
		<Copy SourceFiles="@(_VelaPluginFiles)"
		      DestinationFiles="@(_VelaPluginFiles->'$(VelaArtifactsDir)\plugins\$(VelaPluginDirName)\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />

		<!-- 本机宿主 -->
		<!-- 清掉改名前(目录名 = 原始 id)留下的那一份:两份同 id 会被 PluginManager 判重,
		     后来者标 Invalid,表象是"插件莫名其妙用不了",很难往构建产物残留上想。
		     只在两个名字确实不同时才删,免得 id 本就无点号时把刚要写的目录删掉。 -->
		<RemoveDir Directories="$(VelaDevAppDir)\plugins\$(VelaPluginId)"
		           Condition="'$(VelaDevAppDir)' != '' and '$(VelaPluginDirName)' != '$(VelaPluginId)'" />
		<Copy SourceFiles="@(_VelaPluginFiles)"
		      DestinationFiles="@(_VelaPluginFiles->'$(VelaDevAppDir)\plugins\$(VelaPluginDirName)\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true"
		      Condition="'$(VelaDevAppDir)' != ''" />
	</Target>

	<!-- 仓库内插件也能出 .vpx:`dotnet build plugins/VelaShell.Plugin.X -t:PackVpx`。
	     用的是 tools/VelaShell.Plugin.Cli(与对外 SDK 包里随包分发的是同一份代码),
	     先把它构建出来再调 —— 第一方插件与第三方插件因此走完全一样的打包路径,
	     格式出问题我们自己先撞上。 -->
	<Target Name="PackVpx" DependsOnTargets="Build" Condition="'$(VelaPluginId)' != ''">
		<PropertyGroup>
			<_VelaCliProject>$(MSBuildThisFileDirectory)..\tools\VelaShell.Plugin.Cli\VelaShell.Plugin.Cli.csproj</_VelaCliProject>
			<_VelaCliDll>$(MSBuildThisFileDirectory)..\tools\VelaShell.Plugin.Cli\bin\$(Configuration)\net11.0\VelaShell.Plugin.Cli.dll</_VelaCliDll>
			<VelaVpxOutputDirectory Condition="'$(VelaVpxOutputDirectory)' == ''">$(MSBuildProjectDirectory)\bin\vpx\</VelaVpxOutputDirectory>
		</PropertyGroup>
		<MSBuild Projects="$(_VelaCliProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
		<MakeDir Directories="$(VelaVpxOutputDirectory)" />
		<PropertyGroup>
			<_VelaPackArgs>pack &quot;$(TargetDir.TrimEnd('\'))&quot; --output &quot;$(VelaVpxOutputDirectory.TrimEnd('\'))&quot;</_VelaPackArgs>
			<_VelaPackArgs Condition="'$(VelaSigningKey)' != ''">$(_VelaPackArgs) --key &quot;$(VelaSigningKey)&quot;</_VelaPackArgs>
		</PropertyGroup>
		<Exec Command="dotnet exec &quot;$(_VelaCliDll)&quot; $(_VelaPackArgs)" />
	</Target>

	<!-- 发布期契约:由 build/PluginBundle.proj 调用(拆库之前是宿主的
	     src/VelaShell/VelaShell.csproj 直接调),返回"该随应用分发的文件 + 它在安装包
	     plugins/ 下的相对路径"。VelaPluginShip=false 的插件返回空集 —— 于是它整个不进发行产物。
	     排除 pdb/xml:调试符号与文档注释对最终用户没有意义,也别撑大包体
	     (Windows/便携版发布后还会再扫一遍删 pdb,这里先不产出更省事)。 -->
	<Target Name="GetVelaPluginPayload" DependsOnTargets="Build" Returns="@(VelaPluginPayload)">
		<ItemGroup Condition="'$(VelaPluginShip)' == 'true' and '$(VelaPluginId)' != ''">
			<_VelaPluginPayloadFile Include="$(TargetDir)**\*" Exclude="$(TargetDir)**\*.pdb;$(TargetDir)**\*.xml" />
			<VelaPluginPayload Include="@(_VelaPluginPayloadFile)">
				<VelaPluginRelativePath>$(VelaPluginDirName)\%(_VelaPluginPayloadFile.RecursiveDir)%(_VelaPluginPayloadFile.Filename)%(_VelaPluginPayloadFile.Extension)</VelaPluginRelativePath>
			</VelaPluginPayload>
		</ItemGroup>
	</Target>
</Project>
